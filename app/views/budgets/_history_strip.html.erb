<%# locals: (budget:, history:) %>
<%# How the last few periods went, oldest on the left: each bar is that period's spending,
    on a scale up to 125% of its limit (which can include rollover), with the limit as a dashed
    line. Faded bars have partial data. %>
<% noun = "month" %>
<% complete = history.reject(&:last) %>
<% if history.any? %>
  <div>
    <div class="flex items-baseline justify-between gap-2 text-xs">
      <span class="font-medium text-base-content/80">History</span>
      <span class="text-base-content/60">
        <% if complete.any? %>
          Under budget in <%= complete.count { |status, _| !status.over? } %> of the last <%= pluralize(complete.size, noun) %>
        <% else %>
          Not enough history yet
        <% end %>
      </span>
    </div>
    <ol class="mt-2 flex gap-1.5" aria-label="<%= budget.name %>, last <%= pluralize(history.size, noun) %>">
      <% history.reverse_each do |status, partial| %>
        <% label = "#{status.starts_on.strftime("%b %-d")} – #{(status.resets_on - 1).strftime("%b %-d")}" %>
        <% height = status.spent.positive? ? (status.spent / (status.limit * 1.25) * 100).to_f.clamp(3, 100) : 0 %>
        <li class="flex min-w-0 flex-1 flex-col items-center gap-1" title="<%= label %>: <%= number_to_currency(status.spent) %> of <%= number_to_currency(status.limit) %><%= " (partial data)" if partial %>">
          <div class="relative h-10 w-full" aria-hidden="true">
            <div class="absolute inset-x-0 top-[20%] border-t border-dashed border-base-content/30"></div>
            <div class="<%= class_names("absolute inset-x-0 bottom-0 rounded-t-sm", status.over? ? "bg-error" : "bg-base-content/70", "opacity-40": partial) %>" style="height: <%= height.round(1) %>%"></div>
          </div>
          <span class="max-w-full truncate text-[10px] text-base-content/60" aria-hidden="true"><%= status.starts_on.strftime("%b") %></span>
          <span class="sr-only"><%= label %>: <%= number_to_currency(status.spent) %> of <%= number_to_currency(status.limit) %>, <%= status.over? ? "over budget" : "under budget" %><%= ", partial data" if partial %></span>
        </li>
      <% end %>
    </ol>
  </div>
<% end %>
