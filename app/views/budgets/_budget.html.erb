<%# locals: (budget:, status:, link: false, title: true) %>
<%# A budget's spending this period against its limit, with its recent history. %>
<% state = budget_state(status) %>
<section class="card border border-base-300 bg-base-100" aria-labelledby="budget-<%= budget.id %>">
  <div class="card-body gap-4 p-6">
    <div class="flex items-start justify-between gap-3">
      <div class="min-w-0">
        <h2 id="budget-<%= budget.id %>" class="<%= class_names("truncate text-lg font-bold tracking-tight", "sr-only": !title) %>"><%= link ? link_to(budget.name, budget_path(budget), class: "hover:underline") : budget.name %></h2>
        <p class="text-sm text-base-content/60"><%= Budget::PERIODS.fetch(budget.period) %><%= " · Rolls over" if budget.rollover? %> · <span class="whitespace-nowrap"><%= budget_resets_on(status) %></span></p>
      </div>
      <span class="badge badge-soft <%= state[:badge] %> shrink-0 gap-1">
        <% case status.state %>
        <% when :on_track %>
          <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m5 12 5 5 9-10"/></svg>
        <% when :over_pace %>
          <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 17 17 7M9 7h8v8"/></svg>
        <% else %>
          <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" aria-hidden="true"><path d="M12 7v6M12 17h.01"/></svg>
        <% end %>
        <%= state[:label] %>
      </span>
    </div>

    <div class="flex items-baseline justify-between gap-3">
      <div>
        <p><span class="text-2xl font-bold tracking-tight tabular-nums"><%= number_to_currency(status.spent) %></span> <span class="text-sm text-base-content/60">of <%= number_to_currency(status.limit) %></span></p>
        <% if status.carried.positive? %><p class="text-xs text-base-content/60">Includes <%= number_to_currency(status.carried) %> rolled over</p><% end %>
      </div>
      <p class="flex-none text-sm font-medium tabular-nums">
        <%= status.remaining.negative? ? "#{number_to_currency(-status.remaining)} over" : "#{number_to_currency(status.remaining)} left" %>
      </p>
    </div>

    <div>
      <div class="relative h-2.5 rounded-full bg-base-200" role="img"
           aria-label="<%= number_to_percentage(status.percent, precision: 0) %> spent, <%= number_to_percentage(status.elapsed_percent, precision: 0) %> of the period passed">
        <div class="h-full rounded-full <%= state[:bar] %>" style="width: <%= status.percent.clamp(0, 100).round(1) %>%"></div>
        <div class="absolute -inset-y-1 w-0.5 -translate-x-1/2 rounded-full bg-base-content/50" style="left: <%= status.elapsed_percent.round(1) %>%" aria-hidden="true"></div>
      </div>
      <p class="mt-1.5 flex justify-between text-xs text-base-content/60">
        <span><%= number_to_percentage(status.percent, precision: 0) %> spent</span>
        <span>Marker: <%= number_to_percentage(status.elapsed_percent, precision: 0) %> of the month passed</span>
      </p>
    </div>

    <%= render "history_strip", budget:, history: budget.history(6) %>

    <div class="flex flex-wrap items-center justify-between gap-2">
      <ul class="flex min-w-0 flex-wrap gap-1.5" aria-label="Counts">
        <% budget_includes(budget).each do |item| %>
          <li class="badge badge-ghost badge-sm"><%= item %></li>
        <% end %>
      </ul>
      <%= link_to "Edit", edit_budget_path(budget), class: "btn btn-ghost btn-sm", aria: { label: "Edit #{budget.name}" } %>
    </div>
  </div>
</section>
