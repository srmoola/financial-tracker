<%# locals: (budget:, status:) %>
<%# A budget on the Budgets page: this month at a glance, linking to the budget's own page. %>
<%= link_to budget_path(budget), class: "card border border-base-300 bg-base-100 transition hover:-translate-y-0.5 hover:shadow-lg hover:shadow-black/5" do %>
  <div class="card-body gap-4 p-6">
    <div class="flex items-start justify-between gap-3">
      <h2 class="min-w-0 truncate text-lg font-bold tracking-tight"><%= budget.name %></h2>
      <%= render "status_badge", status: %>
    </div>

    <div class="flex items-baseline justify-between gap-3">
      <p><span class="text-2xl font-bold tracking-tight tabular-nums"><%= number_to_currency(status.spent) %></span> <span class="text-sm text-base-content/60">of <%= number_to_currency(status.limit) %></span></p>
      <p class="flex-none text-sm font-medium tabular-nums"><%= status.remaining.negative? ? "#{number_to_currency(-status.remaining)} over" : "#{number_to_currency(status.remaining)} left" %></p>
    </div>

    <div>
      <%= render "progress", status: %>
      <p class="mt-2 flex justify-between gap-3 text-xs text-base-content/60">
        <span><%= number_to_percentage(status.percent, precision: 0) %> spent<%= " · includes #{number_to_currency(status.carried)} rolled over" if status.carried.positive? %></span>
        <span class="whitespace-nowrap"><%= budget_resets_on(status) %></span>
      </p>
    </div>
  </div>
<% end %>
