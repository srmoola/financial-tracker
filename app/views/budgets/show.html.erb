<% content_for :title, "#{@budget.name} · Budgets · Financial Tracker" %>

<%= link_to budgets_path, class: "inline-flex items-center gap-1 text-sm font-medium text-base-content/70 hover:text-base-content" do %>
  <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5M11 6l-6 6 6 6"/></svg>
  Budgets
<% end %>
<div class="mt-2 flex flex-wrap items-center justify-between gap-3">
  <h1 class="min-w-0 text-3xl font-bold tracking-tight break-words"><%= @budget.name %></h1>
  <%= link_to "Edit budget", edit_budget_path(@budget), class: "btn btn-outline" %>
</div>

<%# Everything below updates in place (switching months, taking transactions out) without reloading the page. %>
<%= turbo_frame_tag "budget_content", class: "block transition-opacity aria-busy:opacity-60",
      data: { turbo_action: "advance", controller: "frame-scroll", action: "turbo:click->frame-scroll#remember turbo:before-frame-render->frame-scroll#keepPosition turbo:frame-render->frame-scroll#restore" } do %>
  <% past = @back.positive? %>
  <% period = "#{@status.starts_on.strftime("%b %-d")} – #{(@status.resets_on - 1).strftime("%b %-d")}" %>
  <%# What picking a month scrolls to: its banner (for a past month) and card. %>
  <div id="period" class="mt-8 scroll-mt-4">
  <% if past %>
    <div class="flex flex-wrap items-center justify-between gap-3 rounded-box border border-secondary/30 bg-secondary/10 px-5 py-3" role="status">
      <p class="flex items-center gap-2 text-sm font-medium">
        <svg class="size-4 shrink-0 text-secondary" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
        You're looking at a past month: <%= period %>
      </p>
      <%= link_to budget_path(@budget), class: "btn btn-sm btn-primary", data: { scroll_to: "#period" } do %>
        <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5M11 6l-6 6 6 6"/></svg>
        Back to this month
      <% end %>
    </div>
  <% end %>
  <div class="<%= class_names("grid gap-6 lg:grid-cols-3", "mt-4": past) %>">
    <section id="month" class="<%= class_names("card border lg:col-span-2", past ? "border-secondary/30 bg-secondary/5" : "border-base-300 bg-base-100") %>" aria-labelledby="month-heading">
      <div class="card-body gap-5 p-6 sm:p-8">
        <div class="flex items-start justify-between gap-3">
          <div>
            <% if past %><p class="text-xs font-semibold tracking-wide text-secondary uppercase">Past month</p><% end %>
            <h2 id="month-heading" class="text-lg font-bold tracking-tight"><%= past ? period : "This month" %></h2>
            <p class="text-sm text-base-content/60">
              <% if past %>
                Ended <%= (@status.resets_on - 1).strftime("%b %-d, %Y") %>
              <% else %>
                <%= period %> · <span class="whitespace-nowrap"><%= budget_resets_on(@status) %></span>
              <% end %>
            </p>
          </div>
          <%= render "status_badge", status: @status, past: %>
        </div>

        <div class="flex flex-wrap items-baseline justify-between gap-3">
          <p><span class="text-4xl font-bold tracking-tight tabular-nums"><%= number_to_currency(@status.spent) %></span> <span class="text-base-content/60">of <%= number_to_currency(@status.limit) %></span></p>
          <p class="flex-none text-lg font-semibold tabular-nums"><%= @status.remaining.negative? ? "#{number_to_currency(-@status.remaining)} over" : "#{number_to_currency(@status.remaining)} #{past ? "under" : "left"}" %></p>
        </div>

        <div>
          <%= render "progress", status: @status, size: "h-3" %>
          <p class="mt-2 flex flex-wrap justify-between gap-x-4 gap-y-1 text-sm text-base-content/60">
            <span><%= number_to_percentage(@status.percent, precision: 0) %> spent</span>
            <% unless past %><span><%= number_to_percentage(@status.elapsed_percent, precision: 0) %> of the month has passed</span><% end %>
          </p>
        </div>

        <% if @status.carried.positive? %>
          <p class="text-sm text-base-content/70">The limit includes <span class="font-semibold"><%= number_to_currency(@status.carried) %></span> rolled over from the month before.</p>
        <% end %>
      </div>
    </section>

    <section class="card border border-base-300 bg-base-100" aria-labelledby="details-heading">
      <div class="card-body gap-4 p-6">
        <h2 id="details-heading" class="text-lg font-bold tracking-tight">Details</h2>
        <dl class="space-y-4 text-sm">
          <div>
            <dt class="text-base-content/60">Monthly limit</dt>
            <dd class="font-semibold tabular-nums"><%= number_to_currency(@budget.amount) %></dd>
          </div>
          <div>
            <dt class="text-base-content/60">Period</dt>
            <dd class="font-medium">Your card's statement month</dd>
          </div>
          <div>
            <dt class="text-base-content/60">Rollover</dt>
            <dd class="font-medium"><%= @budget.rollover? ? "On, since #{@budget.rollover_started_on.strftime("%b %-d, %Y")}" : "Off" %></dd>
          </div>
          <div>
            <dt class="text-base-content/60">Counts</dt>
            <dd class="mt-1">
              <ul class="flex flex-wrap gap-1.5">
                <% budget_includes(@budget).each do |item| %>
                  <li class="badge badge-ghost"><%= item %></li>
                <% end %>
              </ul>
            </dd>
          </div>
          <div>
            <dt class="text-base-content/60">Alerts</dt>
            <dd class="font-medium">Emails at 50%, 90% and 100%</dd>
          </div>
        </dl>
      </div>
    </section>
  </div>
  </div>

  <section class="mt-10" aria-labelledby="transactions-heading">
    <h2 id="transactions-heading" class="text-lg font-bold tracking-tight">Transactions</h2>
    <p class="text-sm text-base-content/60">
      <%= past ? period : "This month" %> · <%= pluralize(@transactions.size, "transaction") %> adding up to <%= number_to_currency(@status.spent) %>, biggest first
    </p>

    <% if @transactions.empty? %>
      <div class="card mt-3 border border-dashed border-base-300 bg-base-100">
        <div class="card-body items-center p-8 text-center">
          <p class="text-sm text-base-content/60">Nothing counts toward this budget <%= past ? "in #{period}" : "yet this month" %>.</p>
        </div>
      </div>
    <% else %>
      <%# The 5 biggest; the rest open up below them (and close again). %>
      <% shown, more = @transactions.first(5), @transactions.drop(5) %>
      <div class="group card mt-3 overflow-hidden border border-base-300 bg-base-100" data-controller="disclosure">
        <ul class="divide-y divide-base-300">
          <% shown.each do |transaction| %>
            <%= render "budget_transaction", budget: @budget, transaction:, back: @back, excluded: false %>
          <% end %>
        </ul>
        <% if more.any? %>
          <ul id="more-budget-transactions" class="divide-y divide-base-300 border-t border-base-300" hidden data-disclosure-target="panel">
            <% more.each do |transaction| %>
              <%= render "budget_transaction", budget: @budget, transaction:, back: @back, excluded: false %>
            <% end %>
          </ul>
          <button type="button" class="flex w-full cursor-pointer items-center justify-center gap-1.5 border-t border-base-300 px-6 py-3 text-sm font-medium text-base-content/70 transition-colors hover:bg-base-200/60 hover:text-base-content"
                  aria-expanded="false" aria-controls="more-budget-transactions" data-disclosure-target="button" data-action="disclosure#toggle">
            <span class="group-data-open:hidden">Show all <%= @transactions.size %> transactions</span>
            <span class="hidden group-data-open:inline">Show less</span>
            <svg class="size-4 transition-transform group-data-open:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
          </button>
        <% end %>
      </div>
    <% end %>

    <% if @excluded.any? %>
      <details class="group mt-4">
        <summary class="cursor-pointer text-sm font-medium text-base-content/70 hover:text-base-content">Not counted (<%= @excluded.size %>)</summary>
        <ul class="card mt-3 divide-y divide-base-300 border border-base-300 bg-base-100">
          <% @excluded.each do |transaction| %>
            <%= render "budget_transaction", budget: @budget, transaction:, back: @back, excluded: true %>
          <% end %>
        </ul>
      </details>
    <% end %>
  </section>

  <section class="mt-10" aria-labelledby="history-heading">
    <h2 id="history-heading" class="text-lg font-bold tracking-tight">History</h2>
    <p class="text-sm text-base-content/60">Each past statement month, judged against this budget as it is now. Pick one to see its transactions.</p>

    <% if @history.empty? %>
      <div class="card mt-3 border border-dashed border-base-300 bg-base-100">
        <div class="card-body items-center p-10 text-center">
          <p class="font-semibold">No history yet</p>
          <p class="text-sm text-base-content/60">Past months show up here once you have transactions from before this one.</p>
        </div>
      </div>
    <% else %>
      <ol class="card mt-3 divide-y divide-base-300 overflow-hidden border border-base-300 bg-base-100">
        <% @history.each_with_index do |(status, partial), index| %>
          <% selected = index + 1 == @back %>
          <li>
            <%= link_to budget_path(@budget, back: index + 1), class: class_names("flex items-center gap-4 px-6 py-4 transition-colors hover:bg-base-200/60", "bg-base-200": selected),
                  aria: { current: selected || nil }, data: { scroll_to: "#period" } do %>
              <span class="<%= class_names("grid size-6 shrink-0 place-items-center rounded-full", status.over? ? "bg-error/15 text-error" : "bg-success/15 text-success") %>" aria-hidden="true">
                <% if status.over? %>
                  <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round"><path d="M6 6l12 12M18 6 6 18"/></svg>
                <% else %>
                  <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="m5 12 5 5 9-10"/></svg>
                <% end %>
              </span>
              <div class="min-w-0 flex-1">
                <p class="font-medium"><%= status.starts_on.strftime("%b %-d") %> – <%= (status.resets_on - 1).strftime(status.resets_on.year == Date.current.year ? "%b %-d" : "%b %-d, %Y") %></p>
                <p class="text-sm text-base-content/60 tabular-nums">
                  <%= number_to_currency(status.spent) %> of <%= number_to_currency(status.limit) %><%= " (#{number_to_currency(status.carried)} rolled over)" if status.carried.positive? %>
                  <% if partial %><span class="text-base-content/50">· partial: your data starts partway through</span><% end %>
                </p>
              </div>
              <p class="<%= class_names("flex-none text-right text-sm font-semibold tabular-nums", status.over? ? "text-error" : "text-success") %>">
                <%= status.over? ? "Over by #{number_to_currency(-status.remaining)}" : "Under by #{number_to_currency(status.remaining)}" %>
              </p>
            <% end %>
          </li>
        <% end %>
      </ol>
    <% end %>
  </section>
<% end %>
