<% content_for :title, "#{@budget.name_was} · Budgets · Financial Tracker" %>

<%= link_to budget_path(@budget), class: "inline-flex items-center gap-1 text-sm font-medium text-base-content/70 hover:text-base-content" do %>
  <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M19 12H5M11 6l-6 6 6 6"/></svg>
  <%= @budget.name_was %>
<% end %>
<div class="mt-2 flex flex-wrap items-center justify-between gap-3">
  <h1 class="text-3xl font-bold tracking-tight">Edit <%= @budget.name_was %></h1>
  <%= button_to "Delete budget", budget_path(@budget), method: :delete, class: "btn btn-ghost text-error",
        form: { data: { turbo_confirm: "Delete #{@budget.name_was}? This can't be undone.", confirm_button: "Delete budget" } } %>
</div>

<div class="card mt-8 border border-base-300 bg-base-100">
  <div class="card-body p-6 sm:p-8">
    <%= render "form", budget: @budget %>
  </div>
</div>
