<%# locals: (history:, spending:, view:, range:, chart_range:, list_category: nil) %>
<%# Spending over time, for every category (the list's category filter doesn't apply).
    `range` and `list_category` are the list's, kept in this chart's links. %>
<% points = history.points %>
<% categories = spending.categories %>
<% colors = categories.zip(spending_colors(categories)).to_h { |category, color| [ category.key, color ] } %>
<% series =
     if view == "categories"
       categories.map { |category| LineChartHelper::Series.new(key: category.key, label: category.label, color: colors.fetch(category.key), values: points.map { |point| point.by_category[category.key].to_f }) }
     else
       [ LineChartHelper::Series.new(key: :total, label: "Spending", color: "#111112", values: points.map { |point| point.total.to_f }) ]
     end %>
<% headline = history.daily? ? "Spent so far" : "Spent" %>
<% tooltip_rows = points.map do |point|
     [ [ headline, number_to_currency(point.total), nil ] ] +
       categories.filter_map { |category| [ category.label, number_to_currency(point.by_category[category.key]), colors.fetch(category.key) ] if point.by_category[category.key].positive? }
   end %>
<% description = history.daily? ? "Running total by day" : "Total per statement month" %>
<% x_labels = history.daily? ? nil : points.each_index.map { |index| [ index, points[index].date.strftime("%b %-d") ] }.select.with_index { |_, index| points.size <= 7 || index.even? || index == points.size - 1 } %>

<section class="card border border-base-300 bg-base-100" aria-labelledby="spending-over-time-heading">
  <div class="card-body gap-5 p-6 sm:p-8">
    <div class="flex flex-wrap items-start justify-between gap-3">
      <div>
        <h2 id="spending-over-time-heading" class="text-lg font-bold tracking-tight">Spending over time</h2>
        <p class="text-sm text-base-content/60">
          <%= description %><%= " since #{points.first.date.strftime(points.first.date.year == Date.current.year ? "%b %-d" : "%b %-d, %Y")}" if history.daily? %>
        </p>
      </div>
      <div class="flex flex-wrap items-center gap-2">
        <% unless history.empty? %>
          <nav class="tabs tabs-box tabs-sm" aria-label="Spending chart lines">
            <% [ [ "total", "Total" ], [ "categories", "By category" ] ].each do |key, label| %>
              <%= link_to label, transactions_path(range:, category: list_category, spending_view: key, chart_range:), class: class_names("tab", "tab-active": view == key), aria: { current: (view == key) || nil } %>
            <% end %>
          </nav>
        <% end %>
        <nav class="tabs tabs-box tabs-sm" aria-label="Spending chart time range">
          <% TransactionsController::RANGES.each do |key, label| %>
            <%= link_to label, transactions_path(range:, category: list_category, spending_view: view, chart_range: key), class: class_names("tab", "tab-active": key == chart_range), aria: { current: (key == chart_range) || nil } %>
          <% end %>
        </nav>
      </div>
    </div>

    <% if history.empty? %>
      <p class="py-6 text-center text-base-content/60">No purchases to chart for this range.</p>
    <% elsif points.size < 2 %>
      <p class="py-6 text-center text-base-content/60">Not enough history yet to show a trend.</p>
    <% else %>
      <% if series.size > 1 %>
        <ul class="flex flex-wrap items-center gap-x-4 gap-y-1 text-sm" aria-label="Legend">
          <% series.each do |line| %>
            <li class="flex items-center gap-2">
              <span class="h-0.5 w-4 rounded-full" style="background-color: <%= line.color %>" aria-hidden="true"></span>
              <%= line.label %>
            </li>
          <% end %>
        </ul>
      <% end %>

      <% chart = line_chart(points.map(&:date), series, tooltip_rows:, hover_labels: points.map(&:label), x_labels:) %>
      <%= render "shared/line_chart", chart:,
            aria_label: "Spending, #{description.downcase}, from #{points.first.label} (#{number_to_currency(series.first.values.first)}) to #{points.last.label} (#{number_to_currency(series.first.values.last)}). Use the left and right arrow keys to read each value, and Enter to see its largest purchases.",
            details: points.map { |point| render("point_purchases", point:, daily: history.daily?) },
            details_hint: "Click to see the top purchases" %>

      <%# sr-only goes on a wrapper: a table can't shrink to 1px, so it would still widen the page. %>
      <div class="sr-only">
        <table>
          <caption>Spending: <%= description.downcase %></caption>
          <thead><tr><th scope="col"><%= history.daily? ? "Date" : "Statement month" %></th><th scope="col">Total</th><% categories.each do |category| %><th scope="col"><%= category.label %></th><% end %></tr></thead>
          <tbody>
            <% points.each do |point| %>
              <tr><td><%= point.label %></td><td><%= number_to_currency(point.total) %></td><% categories.each do |category| %><td><%= number_to_currency(point.by_category[category.key]) %></td><% end %></tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>
  </div>
</section>
