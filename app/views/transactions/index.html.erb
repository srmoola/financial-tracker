<% content_for :title, "Transactions · Financial Tracker" %>

<h1 class="text-3xl font-bold tracking-tight">Transactions</h1>

<% if @credit_cards.empty? %>
  <section class="card mt-8 border border-base-300 bg-base-100">
    <div class="card-body gap-4 p-6 sm:p-8">
      <div>
        <h2 class="text-xl font-bold tracking-tight">Connect a credit card</h2>
        <p class="mt-1 text-base-content/70">Transactions come from your connected credit cards. Connect one to see your spending.</p>
      </div>
      <%= render "plaid/connect_buttons", from: "accounts" %>
    </div>
  </section>
<% else %>
  <% category_label = @category && (@spending.categories.find { |category| category.param == @category }&.label || SpendingBreakdown.label_for(@category == "uncategorized" ? nil : @category)) %>

  <%# Everything below updates in place (ranges, category, page) without reloading the page. %>
  <%= turbo_frame_tag "transactions_content", class: "block transition-opacity aria-busy:opacity-60",
        data: { turbo_action: "advance", controller: "frame-scroll recategorize transaction-note transaction-split", transaction_note_max_length_value: Transaction::NOTE_MAX_LENGTH, action: "turbo:click->frame-scroll#remember turbo:before-frame-render->frame-scroll#keepPosition turbo:frame-render->frame-scroll#restore recategorize:split->transaction-split#openFromPicker" } do %>
    <% if @plaid_items_needing_consent.any? %>
      <div class="mt-4 flex flex-col gap-3"><%= render "plaid/statement_dates_prompt", plaid_items: @plaid_items_needing_consent, from: "transactions" %></div>
    <% end %>

    <% if !@any_transactions %>
      <section class="card mt-6 border border-dashed border-base-300 bg-base-100">
        <div class="card-body items-center p-10 text-center">
          <p class="font-semibold">Your transactions are on the way</p>
          <p class="max-w-md text-sm text-base-content/60">They're imported when your accounts sync, which happens every morning and shortly after you connect a card.</p>
        </div>
      </section>
    <% else %>
      <% unless @list_only %>
        <div class="mt-6">
          <%= render "spending", spending: @spending, range: @range, range_heading: range_heading(@range, @credit_cards, @earliest_date),
                range_text: range_phrase(@range, @credit_cards), selected: @category %>
        </div>

        <div class="mt-6">
          <%= render "spending_history", history: @spending_history, spending: @spending, view: @spending_view, chart_range: @chart_range %>
        </div>
      <% end %>

      <%# The list updates on its own (search, its range and category, pages), leaving the donut and chart alone. %>
      <%= turbo_frame_tag "transactions_list", class: "mt-6 block transition-opacity aria-busy:opacity-60", data: { turbo_action: "advance" } do %>
      <section class="card border border-base-300 bg-base-100" aria-labelledby="transactions-heading">
        <div class="card-body gap-0 p-0">
          <div class="flex flex-col gap-3 px-6 pt-6 pb-4 sm:px-8">
            <div class="flex flex-wrap items-start justify-between gap-x-4 gap-y-1">
              <div>
                <h2 id="transactions-heading" class="scroll-mt-4 text-lg font-bold tracking-tight">Transactions</h2>
                <p class="text-sm text-base-content/60"><%= range_heading(@list_range, @credit_cards, @earliest_date) %></p>
              </div>
              <p class="flex-none text-sm text-base-content/60">
                <% if @total_count.zero? %>
                  No transactions
                <% else %>
                  Showing <%= (@page - 1) * TransactionsController::PER_PAGE + 1 %>–<%= [ @page * TransactionsController::PER_PAGE, @total_count ].min %> of <%= number_with_delimiter(@total_count) %>
                <% end %>
              </p>
            </div>
            <div class="flex flex-wrap items-center gap-2">
              <nav class="tabs tabs-box tabs-sm" aria-label="Transactions time range">
                <% TransactionsController::RANGES.each do |key, label| %>
                  <%= link_to label, transactions_path_with(list_range: key), class: class_names("tab", "tab-active": key == @list_range), aria: { current: (key == @list_range) || nil } %>
                <% end %>
              </nav>
              <%# Typing in the search box updates the list in place; the box itself is kept across
                  updates (data-turbo-permanent) so it keeps focus and what's typed. Searches replace
                  the history entry rather than adding one per keystroke. %>
              <%= form_with url: transactions_path, method: :get, class: "flex min-w-0 flex-1 flex-wrap items-center gap-2",
                    data: { controller: "auto-submit", turbo_action: "replace" } do |form| %>
                <%= form.hidden_field :range, value: @range %>
                <%= form.hidden_field :list_range, value: @list_range %>
                <%= form.hidden_field :chart_range, value: @chart_range %>
                <%= form.hidden_field :spending_view, value: @spending_view %>
                <%= form.search_field :q, value: @query, id: "transactions-search", placeholder: "Search transactions", autocomplete: "off",
                      class: "input input-sm min-w-40 flex-1 sm:max-w-64", aria: { label: "Search transactions" },
                      data: { turbo_permanent: true, action: "input->auto-submit#submitSoon" } %>
                <%= form.select :category, options_for_select(@category_options, @category), { include_blank: "All categories" },
                      class: class_names("select select-sm w-auto", "select-primary": @category), aria: { label: "Filter by category" },
                      data: { action: "auto-submit#submit" } %>
              <% end %>
            </div>
          </div>

          <% if @transactions.empty? %>
            <div class="border-t border-base-300 px-6 py-10 text-center text-base-content/60 sm:px-8">
              <% if @query %>
                <p>No <%= category_label ? "#{category_label} " : "" %>transactions matching “<%= @query %>” <%= range_phrase(@list_range, @credit_cards) %>.</p>
                <% unless @list_range == "all" %>
                  <p class="mt-2"><%= link_to "Search all transactions", transactions_path_with(list_range: "all"), class: "font-medium text-base-content hover:underline" %></p>
                <% end %>
              <% else %>
                <p>No <%= category_label ? "#{category_label} " : "" %>transactions <%= range_phrase(@list_range, @credit_cards) %>.</p>
              <% end %>
            </div>
          <% else %>
            <% @transactions.group_by(&:date).each do |date, transactions_on_day| %>
              <h3 class="border-y border-base-300 bg-base-200/60 px-6 py-2 text-xs font-semibold uppercase tracking-wide text-base-content/60 sm:px-8">
                <%= date == Date.current ? "Today" : (date == Date.yesterday ? "Yesterday" : date.strftime("%a, %b %-d, %Y")) %>
              </h3>
              <ul class="divide-y divide-base-300">
                <% transactions_on_day.each do |transaction| %>
                  <% account = transaction.account %>
                  <li class="flex items-center gap-4 px-6 py-3 sm:px-8">
                    <%= merchant_logo(transaction.logo_url, transaction.masked_description? ? "?" : transaction.display_name) %>
                    <div class="min-w-0 flex-1">
                      <p class="flex items-center gap-2 font-medium">
                        <span class="truncate"><%= transaction.display_name %></span>
                        <% if transaction.pending %><span class="badge badge-sm badge-soft badge-warning shrink-0">Pending</span><% end %>
                      </p>
                      <div class="flex min-w-0 items-center gap-1 text-xs text-base-content/60">
                        <% if transaction.split? %>
                          <% split_labels = transaction.splits.map { |split| SpendingBreakdown.label_for(split.category) } %>
                          <button type="button"
                                  class="-ml-1.5 inline-flex min-w-0 cursor-pointer items-center gap-1 rounded-md px-1.5 py-0.5 font-medium text-base-content/80 transition-colors hover:bg-base-200"
                                  aria-label="Split into <%= transaction.splits.map { |split| "#{SpendingBreakdown.label_for(split.category)} #{number_to_currency(split.amount)}" }.to_sentence %>. Change split"
                                  data-action="transaction-split#open"
                                  data-transaction-split-url-param="<%= transaction_split_path(transaction) %>"
                                  data-transaction-split-merchant-param="<%= transaction.display_name %>"
                                  data-transaction-split-amount-param="<%= number_to_currency(transaction.amount) %>"
                                  data-transaction-split-total-param="<%= transaction.amount.to_s("F") %>"
                                  data-transaction-split-parts-param="<%= transaction.splits.map { |split| { category: split.category, amount: split.amount.to_s("F") } }.to_json %>">
                            <span class="truncate">Split · <%= split_labels.join(", ") %></span>
                            <svg class="size-3 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
                          </button>
                        <% else %>
                        <% category_label = SpendingBreakdown.label_for(transaction.effective_category) %>
                        <button type="button"
                                class="-ml-1.5 inline-flex shrink-0 cursor-pointer items-center gap-1 rounded-md px-1.5 py-0.5 font-medium text-base-content/80 transition-colors hover:bg-base-200"
                                aria-label="Category: <%= category_label %><%= " (changed by you)" if transaction.recategorized? %>. Change category"
                                data-action="recategorize#open"
                                data-recategorize-url-param="<%= transaction_path(transaction) %>"
                                data-recategorize-merchant-param="<%= transaction.display_name %>"
                                data-recategorize-amount-param="<%= number_to_currency(transaction.amount.abs) %>"
                                data-recategorize-category-param="<%= transaction.effective_category %>"
                                data-recategorize-plaid-category-param="<%= transaction.category %>"
                                data-recategorize-plaid-label-param="<%= SpendingBreakdown.label_for(transaction.category) %>"
                                data-recategorize-split-url-param="<%= transaction_split_path(transaction) %>"
                                data-recategorize-total-param="<%= transaction.amount.to_s("F") %>">
                          <%= category_label %>
                          <% if transaction.recategorized? %><span class="size-1.5 rounded-full bg-secondary" aria-hidden="true"></span><% end %>
                          <svg class="size-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m6 9 6 6 6-6"/></svg>
                        </button>
                        <% end %>
                        <% if transaction.masked_description? %><span class="truncate max-sm:hidden" title="As it appears on your statement">· <%= transaction.description %></span><% end %>
                        <span class="truncate">· <%= account.name %><%= " •••• #{account.mask}" if account.mask.present? %></span>
                      </div>
                      <% if transaction.note %>
                        <p class="mt-1 flex items-start gap-1.5 text-xs text-base-content/80">
                          <svg class="mt-px size-3.5 shrink-0 text-base-content/50" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 4h16v12H8l-4 4z"/></svg>
                          <span class="line-clamp-2 break-words"><span class="sr-only">Note: </span><%= linkify_note(transaction.note) %></span>
                        </p>
                      <% end %>
                    </div>
                    <button type="button"
                            class="<%= class_names("btn btn-ghost btn-square btn-sm shrink-0", transaction.note ? "text-base-content" : "text-base-content/40 hover:text-base-content") %>"
                            aria-label="<%= transaction.note ? "Edit note" : "Add a note" %> for <%= transaction.display_name %>"
                            title="<%= transaction.note ? "Edit note" : "Add a note" %>"
                            data-action="transaction-note#open"
                            data-transaction-note-url-param="<%= transaction_path(transaction) %>"
                            data-transaction-note-merchant-param="<%= transaction.display_name %>"
                            data-transaction-note-amount-param="<%= number_to_currency(transaction.amount.abs) %>"
                            data-transaction-note-note-param="<%= transaction.note %>">
                      <svg class="size-4" viewBox="0 0 24 24" fill="<%= transaction.note ? "currentColor" : "none" %>" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 4h16v12H8l-4 4z"/></svg>
                    </button>
                    <p class="flex-none font-semibold tabular-nums">
                      <% if transaction.amount.negative? %>+<%= number_to_currency(transaction.amount.abs) %><% else %><%= number_to_currency(transaction.amount) %><% end %>
                    </p>
                  </li>
                <% end %>
              </ul>
            <% end %>
          <% end %>

          <% if @page_count > 1 %>
            <% page_link = ->(number) { transactions_path_with(page: number) } %>
            <nav class="flex justify-center border-t border-base-300 px-6 py-4" aria-label="Pagination">
              <div class="join">
                <% if @page > 1 %>
                  <%= link_to "‹", page_link.(@page - 1), class: "join-item btn btn-sm", aria: { label: "Previous page" }, data: { scroll_to: "#transactions-heading" } %>
                <% else %>
                  <span class="join-item btn btn-sm btn-disabled" aria-hidden="true">‹</span>
                <% end %>
                <% page_window(@page, @page_count).each do |entry| %>
                  <% if entry == :gap %>
                    <span class="join-item btn btn-sm btn-disabled" aria-hidden="true">…</span>
                  <% else %>
                    <%= link_to entry, page_link.(entry), class: class_names("join-item btn btn-sm tabular-nums", "btn-active btn-primary": entry == @page),
                          aria: { current: (entry == @page ? "page" : nil), label: "Page #{entry}" }, data: { scroll_to: "#transactions-heading" } %>
                  <% end %>
                <% end %>
                <% if @page < @page_count %>
                  <%= link_to "›", page_link.(@page + 1), class: "join-item btn btn-sm", aria: { label: "Next page" }, data: { scroll_to: "#transactions-heading" } %>
                <% else %>
                  <span class="join-item btn btn-sm btn-disabled" aria-hidden="true">›</span>
                <% end %>
              </div>
            </nav>
          <% end %>
        </div>
      </section>
      <% end %>

      <%# One shared category picker; each transaction's category button fills it in. %>
      <dialog class="modal modal-bottom sm:modal-middle" aria-labelledby="recategorize-heading" data-recategorize-target="dialog">
        <div class="modal-box">
          <h3 id="recategorize-heading" class="text-lg font-bold tracking-tight">Change category</h3>
          <p class="mt-1 text-sm text-base-content/60">
            <span data-recategorize-target="merchant"></span> · <span class="tabular-nums" data-recategorize-target="amount"></span>
          </p>

          <%= form_with url: transactions_path, method: :patch, data: { recategorize_target: "form" } do %>
            <input type="hidden" name="return_to" data-recategorize-target="returnTo">
            <div class="mt-5 grid grid-cols-2 gap-2">
              <% Transaction::CATEGORIES.each do |category| %>
                <button type="submit" name="category" value="<%= category %>" class="btn btn-sm justify-start font-medium" data-recategorize-target="option">
                  <%= SpendingBreakdown.label_for(category) %>
                </button>
              <% end %>
            </div>
            <button type="submit" name="category" value="" class="btn btn-ghost btn-sm mt-3 px-2" data-recategorize-target="reset" hidden>Reset to Plaid's category (<span data-recategorize-target="plaidCategory"></span>)</button>
          <% end %>
          <button type="button" class="btn btn-sm btn-block mt-3" data-recategorize-target="split" data-action="recategorize#split">
            <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 3v6a6 6 0 0 0 6 6h0a6 6 0 0 0 6-6V3M12 15v6"/></svg>
            Split across categories
          </button>

          <div class="modal-action mt-4">
            <button type="button" class="btn" data-action="recategorize#close">Cancel</button>
          </div>
        </div>
        <form method="dialog" class="modal-backdrop"><button aria-label="Close">close</button></form>
      </dialog>

      <%# One shared note editor; each transaction's note button fills it in. %>
      <dialog class="modal modal-bottom sm:modal-middle" aria-labelledby="split-heading" data-transaction-split-target="dialog">
        <div class="modal-box">
          <h3 id="split-heading" class="text-lg font-bold tracking-tight">Split across categories</h3>
          <p class="mt-1 text-sm text-base-content/60">
            <span data-transaction-split-target="merchant"></span> · <span class="tabular-nums" data-transaction-split-target="total"></span>
          </p>

          <%# A POST form with our own _method field (patch to save, delete to remove the split), so there's only one. %>
          <%= form_with url: transactions_path, method: :post, data: { transaction_split_target: "form", action: "input->transaction-split#update change->transaction-split#update" } do %>
            <input type="hidden" name="_method" value="patch" data-transaction-split-target="method">
            <input type="hidden" name="return_to" data-transaction-split-target="returnTo">
            <div class="mt-5 space-y-2" data-transaction-split-target="parts"></div>
            <template data-transaction-split-target="template">
              <div class="flex items-center gap-2" data-part>
                <select name="parts[][category]" class="select select-sm min-w-0 flex-1" aria-label="Category">
                  <option value="">Category…</option>
                  <% Transaction::CATEGORIES.map { |category| [ SpendingBreakdown.label_for(category), category ] }.sort.each do |label, category| %>
                    <option value="<%= category %>"><%= label %></option>
                  <% end %>
                </select>
                <label class="input input-sm w-28 shrink-0 read-only:bg-base-200">
                  <span class="text-base-content/60">$</span>
                  <input type="number" name="parts[][amount]" min="0.01" step="0.01" inputmode="decimal" placeholder="0.00" class="grow tabular-nums read-only:text-base-content/70" aria-label="Amount">
                </label>
                <button type="button" class="btn btn-ghost btn-square btn-sm shrink-0" aria-label="Remove this part" data-remove data-action="transaction-split#removePart">
                  <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg>
                </button>
              </div>
            </template>
            <button type="button" class="btn btn-ghost btn-sm mt-2 px-2" data-action="transaction-split#addPart">+ Add a part</button>
            <p class="mt-2 min-h-5 text-sm text-base-content/60" data-transaction-split-target="hint" aria-live="polite"></p>

            <div class="modal-action mt-4">
              <button type="button" class="btn btn-ghost mr-auto text-error" data-transaction-split-target="unsplit" data-action="transaction-split#unsplit" hidden>Remove split</button>
              <button type="button" class="btn" data-action="transaction-split#close">Cancel</button>
              <button type="submit" class="btn btn-primary" data-transaction-split-target="save">Save split</button>
            </div>
          <% end %>
        </div>
        <form method="dialog" class="modal-backdrop"><button aria-label="Close">close</button></form>
      </dialog>
      <dialog class="modal modal-bottom sm:modal-middle" aria-labelledby="note-heading" data-transaction-note-target="dialog">
        <div class="modal-box">
          <h3 id="note-heading" class="text-lg font-bold tracking-tight">Note</h3>
          <p class="mt-1 text-sm text-base-content/60">
            <span data-transaction-note-target="merchant"></span> · <span class="tabular-nums" data-transaction-note-target="amount"></span>
          </p>

          <%= form_with url: transactions_path, method: :patch, data: { transaction_note_target: "form" } do %>
            <input type="hidden" name="return_to" data-transaction-note-target="returnTo">
            <label for="transaction-note-field" class="sr-only">Note</label>
            <textarea id="transaction-note-field" name="note" rows="3" maxlength="<%= Transaction::NOTE_MAX_LENGTH %>"
                      class="textarea mt-4 w-full text-base" placeholder="e.g. Groceries for the week, split with Sam"
                      data-transaction-note-target="field" data-action="input->transaction-note#count keydown->transaction-note#submitOnShortcut"></textarea>
            <div class="mt-1 flex justify-between gap-3 text-xs text-base-content/60">
              <span>Only you can see notes.</span>
              <span class="tabular-nums" data-transaction-note-target="count"></span>
            </div>

            <div class="modal-action mt-5">
              <button type="button" class="btn btn-ghost mr-auto text-error" data-transaction-note-target="remove" data-action="transaction-note#remove" hidden>Remove note</button>
              <button type="button" class="btn" data-action="transaction-note#close">Cancel</button>
              <button type="submit" class="btn btn-primary">Save note</button>
            </div>
          <% end %>
        </div>
        <form method="dialog" class="modal-backdrop"><button aria-label="Close">close</button></form>
      </dialog>
    <% end %>
  <% end %>
<% end %>
