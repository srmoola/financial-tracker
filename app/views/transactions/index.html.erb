<% content_for :title, "Transactions · Financial Tracker" %>
<% range_label = { "1m" => "month", "3m" => "3 months", "6m" => "6 months", "1y" => "year" }.fetch(@range) %>

<div class="flex flex-wrap items-center justify-between gap-3">
  <h1 class="text-3xl font-bold tracking-tight">Transactions</h1>
  <% if @credit_cards.any? %>
    <nav class="tabs tabs-box tabs-sm" aria-label="Time range">
      <% NetWorthHistory::RANGES.each_key do |key| %>
        <%= link_to key.upcase, transactions_path(range: key), class: class_names("tab", "tab-active": key == @range), aria: { current: (key == @range) || nil } %>
      <% end %>
    </nav>
  <% end %>
</div>

<% if @credit_cards.empty? %>
  <section class="card mt-8 border border-base-300 bg-base-100">
    <div class="card-body gap-4 p-6 sm:p-8">
      <div>
        <h2 class="text-xl font-bold tracking-tight">Connect a credit card</h2>
        <p class="mt-1 text-base-content/70">Transactions come from your connected credit cards. Connect one to see your spending.</p>
      </div>
      <%= render "plaid/connect_buttons", from: "accounts" %>
    </div>
  </section>
<% elsif !@any_transactions %>
  <section class="card mt-8 border border-dashed border-base-300 bg-base-100">
    <div class="card-body items-center p-10 text-center">
      <p class="font-semibold">Your transactions are on the way</p>
      <p class="max-w-md text-sm text-base-content/60">They're imported when your accounts sync, which happens every morning and shortly after you connect a card.</p>
    </div>
  </section>
<% else %>
  <div class="mt-6">
    <%= render "spending", spending: @spending, range_label: %>
  </div>

  <section class="card mt-6 border border-base-300 bg-base-100" aria-labelledby="transactions-heading">
    <div class="card-body gap-0 p-0">
      <div class="flex flex-col gap-1 px-6 pt-6 pb-2 sm:flex-row sm:items-baseline sm:justify-between sm:gap-3 sm:px-8">
        <h2 id="transactions-heading" class="text-lg font-bold tracking-tight">All transactions</h2>
        <p class="text-sm text-base-content/60"><%= pluralize(@total_count, "transaction") %> in the last <%= range_label %></p>
      </div>

      <% if @transactions.empty? %>
        <p class="px-6 py-10 text-center text-base-content/60 sm:px-8">No transactions in the last <%= range_label %>.</p>
      <% else %>
        <% @transactions.group_by(&:date).each do |date, transactions_on_day| %>
          <h3 class="border-b border-base-300 bg-base-200/60 px-6 py-2 text-xs font-semibold uppercase tracking-wide text-base-content/60 sm:px-8">
            <%= date == Date.current ? "Today" : (date == Date.yesterday ? "Yesterday" : date.strftime("%a, %b %-d, %Y")) %>
          </h3>
          <ul class="divide-y divide-base-300">
            <% transactions_on_day.each do |transaction| %>
              <% account = transaction.account %>
              <li class="flex items-center gap-4 px-6 py-3 sm:px-8">
                <div class="grid size-10 shrink-0 place-items-center rounded-xl bg-base-200 text-sm font-semibold" aria-hidden="true">
                  <%= (transaction.merchant_name.presence || transaction.description).to_s.first.upcase %>
                </div>
                <div class="min-w-0 flex-1">
                  <p class="flex items-center gap-2 font-medium">
                    <span class="truncate"><%= transaction.merchant_name.presence || transaction.description %></span>
                    <% if transaction.pending %><span class="badge badge-sm badge-soft badge-warning shrink-0">Pending</span><% end %>
                  </p>
                  <p class="truncate text-xs text-base-content/60">
                    <%= SpendingBreakdown.label_for(transaction.category) %> · <%= account.name %><%= " •••• #{account.mask}" if account.mask.present? %>
                  </p>
                </div>
                <p class="flex-none font-semibold tabular-nums">
                  <% if transaction.amount.negative? %>+<%= number_to_currency(transaction.amount.abs) %><% else %><%= number_to_currency(transaction.amount) %><% end %>
                </p>
              </li>
            <% end %>
          </ul>
        <% end %>
      <% end %>

      <% if @page_count > 1 %>
        <nav class="flex items-center justify-between gap-3 border-t border-base-300 px-6 py-4 sm:px-8" aria-label="Pagination">
          <% if @page > 1 %>
            <%= link_to "Newer", transactions_path(range: @range, page: @page - 1), class: "btn btn-sm" %>
          <% else %>
            <span class="btn btn-sm btn-disabled" aria-disabled="true">Newer</span>
          <% end %>
          <span class="text-sm text-base-content/60">Page <%= @page %> of <%= @page_count %></span>
          <% if @page < @page_count %>
            <%= link_to "Older", transactions_path(range: @range, page: @page + 1), class: "btn btn-sm" %>
          <% else %>
            <span class="btn btn-sm btn-disabled" aria-disabled="true">Older</span>
          <% end %>
        </nav>
      <% end %>
    </div>
  </section>
<% end %>
