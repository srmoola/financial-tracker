<%# locals: (assets:, debts:, assets_total:, debts_total:, net_worth:) %>
<% segments = donut_segments(assets.map { |account| account.balance.to_f }, radius: 80) %>
<% net_worth_label = number_to_currency(net_worth) %>

<section class="card border border-base-300 bg-base-100" data-controller="donut" aria-labelledby="net-worth-heading">
  <div class="card-body gap-6 p-6 sm:p-8">
    <div class="flex items-center justify-between gap-4">
      <h2 id="net-worth-heading" class="text-lg font-bold tracking-tight">Net worth</h2>
      <span class="badge badge-soft badge-secondary">Sample data</span>
    </div>

    <div class="grid items-center gap-8 lg:grid-cols-[18rem_1fr]">
      <div class="relative mx-auto size-64 sm:size-72">
        <svg viewBox="0 0 200 200" class="size-full" role="img"
             aria-label="<%= "Net worth #{net_worth_label}. Assets by account: " + assets.zip(segments).map { |account, segment| "#{account.name} #{number_to_currency(account.balance)} (#{number_to_percentage(segment.share * 100, precision: 0)})" }.join(", ") %>">
          <g transform="rotate(-90 100 100)">
            <% segments.each_with_index do |segment, index| %>
              <% account = assets[index] %>
              <g class="cursor-pointer outline-none transition-opacity duration-150" tabindex="0"
                 aria-label="<%= account.name %>: <%= number_to_currency(account.balance) %>"
                 data-donut-target="segment"
                 data-action="mouseenter->donut#show focus->donut#show mouseleave->donut#reset blur->donut#reset"
                 data-donut-index-param="<%= index %>">
                <circle cx="100" cy="100" r="80" fill="none" stroke="<%= segment.color %>" stroke-width="24"
                        stroke-dasharray="<%= segment.dasharray %>" stroke-dashoffset="<%= segment.dashoffset %>" />
                <%# Wider, invisible hit area so slices are easy to hover %>
                <circle cx="100" cy="100" r="80" fill="none" stroke="transparent" stroke-width="44"
                        stroke-dasharray="<%= segment.dasharray %>" stroke-dashoffset="<%= segment.dashoffset %>" />
              </g>
            <% end %>
          </g>
        </svg>

        <div class="pointer-events-none absolute inset-0 grid place-items-center text-center" aria-live="polite">
          <div class="max-w-40">
            <p class="text-xs font-medium text-base-content/60" data-donut-target="label">Net worth</p>
            <p class="mt-1 text-2xl font-bold tracking-tight sm:text-3xl" data-donut-target="value"><%= net_worth_label %></p>
            <p class="mt-1 text-xs text-base-content/60" data-donut-target="detail"><%= assets.size %> accounts</p>
          </div>
        </div>
      </div>

      <div>
        <ul class="flex flex-col">
          <% assets.zip(segments).each_with_index do |(account, segment), index| %>
            <li class="flex cursor-default items-center gap-3 rounded-lg px-3 py-2.5 transition-colors"
                data-donut-target="item"
                data-action="mouseenter->donut#show mouseleave->donut#reset"
                data-donut-index-param="<%= index %>"
                data-label="<%= account.name %>"
                data-value="<%= number_to_currency(account.balance) %>"
                data-detail="<%= number_to_percentage(segment.share * 100, precision: 1) %> of assets">
              <span class="size-3 shrink-0 rounded-sm" style="background-color: <%= segment.color %>" aria-hidden="true"></span>
              <div class="min-w-0 flex-1">
                <p class="truncate font-medium"><%= account.name %></p>
                <p class="truncate text-xs text-base-content/60"><%= account.institution %> •••• <%= account.mask %></p>
              </div>
              <div class="text-right">
                <p class="font-semibold tabular-nums"><%= number_to_currency(account.balance) %></p>
                <p class="text-xs tabular-nums text-base-content/60"><%= number_to_percentage(segment.share * 100, precision: 1) %></p>
              </div>
            </li>
          <% end %>
        </ul>

        <div class="mt-4 border-t border-base-300 pt-4">
          <p class="px-3 text-xs font-semibold uppercase tracking-wide text-base-content/60">Debts</p>
          <ul class="mt-1 flex flex-col">
            <% debts.each do |account| %>
              <li class="flex items-center gap-3 px-3 py-2.5">
                <span class="size-3 shrink-0 rounded-sm border border-base-content/30" aria-hidden="true"></span>
                <div class="min-w-0 flex-1">
                  <p class="truncate font-medium"><%= account.name %></p>
                  <p class="truncate text-xs text-base-content/60"><%= account.institution %> •••• <%= account.mask %></p>
                </div>
                <p class="flex-none font-semibold tabular-nums">−<%= number_to_currency(account.balance) %></p>
              </li>
            <% end %>
          </ul>
        </div>

        <dl class="mt-4 grid grid-cols-3 gap-2 rounded-box bg-base-200 p-4 text-center">
          <div>
            <dt class="text-xs text-base-content/60">Assets</dt>
            <dd class="font-semibold tabular-nums"><%= number_to_currency(assets_total) %></dd>
          </div>
          <div>
            <dt class="text-xs text-base-content/60">Debts</dt>
            <dd class="font-semibold tabular-nums">−<%= number_to_currency(debts_total) %></dd>
          </div>
          <div>
            <dt class="text-xs text-base-content/60">Net worth</dt>
            <dd class="font-bold tabular-nums"><%= net_worth_label %></dd>
          </div>
        </dl>
      </div>
    </div>
  </div>
</section>
