<%# locals: (history:, range:, view:) %>
<% points = history.points %>
<% categories = NetWorthBreakdown::GROUPS %>
<% colors = DonutChartHelper::CATEGORY_COLORS %>
<% series =
     if view == "categories"
       categories.map { |key, label| LineChartHelper::Series.new(key:, label:, color: colors.fetch(key), values: points.map { |point| point.categories[key].to_f }) }
     else
       [ LineChartHelper::Series.new(key: :net_worth, label: "Net worth", color: "#111112", values: points.map { |point| point.net_worth.to_f }) ]
     end %>
<% tooltip_rows = points.map do |point|
     [ [ "Net worth", number_to_currency(point.net_worth), nil ] ] +
       categories.map { |key, label| [ label, number_to_currency(point.categories[key]), colors.fetch(key) ] } +
       [ [ "Credit cards", "−#{number_to_currency(point.debts)}", nil ] ]
   end %>
<% chart = line_chart(points.map(&:date), series, tooltip_rows:) %>
<% up = history.change >= 0 %>
<% range_label = { "1m" => "month", "3m" => "3 months", "6m" => "6 months", "1y" => "year" }.fetch(range) %>
<% frame_link = ->(label, active, params) { link_to label, root_path(params), class: class_names("tab", "tab-active": active), aria: { current: active || nil }, data: { turbo_frame: "net_worth_history", turbo_action: "advance" } } %>

<%= turbo_frame_tag "net_worth_history", class: "block transition-opacity aria-busy:opacity-50" do %>
  <section aria-labelledby="net-worth-history-heading">
    <div class="flex flex-wrap items-center justify-between gap-3">
      <h2 id="net-worth-history-heading" class="text-lg font-bold tracking-tight">Net worth over time</h2>
      <div class="flex flex-wrap items-center gap-2">
        <nav class="tabs tabs-box tabs-sm" aria-label="Chart lines">
          <%= frame_link.("Net worth", view == "net_worth", { range:, view: "net_worth" }) %>
          <%= frame_link.("By category", view == "categories", { range:, view: "categories" }) %>
        </nav>
        <nav class="tabs tabs-box tabs-sm" aria-label="Time range">
          <% NetWorthHistory::RANGES.each_key do |key| %>
            <%= frame_link.(key.upcase, key == range, { range: key, view: }) %>
          <% end %>
        </nav>
      </div>
    </div>

    <div class="card mt-3 border border-base-300 bg-base-100">
      <div class="card-body gap-6 p-6 sm:p-8">
        <div class="flex flex-wrap items-center justify-between gap-4">
          <div class="flex flex-wrap items-center gap-x-2 gap-y-1">
            <svg class="size-4 <%= up ? "text-success" : "text-error" %>" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="<%= up ? "M12 19V5M5 12l7-7 7 7" : "M12 5v14M19 12l-7 7-7-7" %>" />
            </svg>
            <span class="font-semibold tabular-nums">
              <%= up ? "+" : "−" %><%= number_to_currency(history.change.abs) %>
              <% if history.change_percent %>(<%= up ? "+" : "−" %><%= number_to_percentage(history.change_percent.abs, precision: 1) %>)<% end %>
            </span>
            <span class="text-sm text-base-content/60">net worth over the last <%= range_label %></span>
          </div>

          <% if chart.lines.size > 1 %>
            <ul class="flex flex-wrap items-center gap-x-4 gap-y-1 text-sm" aria-label="Legend">
              <% chart.lines.each do |line| %>
                <li class="flex items-center gap-2">
                  <span class="h-0.5 w-4 rounded-full" style="background-color: <%= line.color %>" aria-hidden="true"></span>
                  <%= line.label %>
                </li>
              <% end %>
            </ul>
          <% end %>
        </div>

        <%= render "shared/line_chart", chart:,
              aria_label: "Net worth from #{points.first.date.strftime("%b %-d, %Y")} (#{number_to_currency(points.first.net_worth)}) to #{points.last.date.strftime("%b %-d, %Y")} (#{number_to_currency(points.last.net_worth)}). Use the left and right arrow keys to read daily values." %>

        <%# sr-only goes on a wrapper: a table can't shrink to 1px, so it would still widen the page. %>
        <div class="sr-only">
          <table>
            <caption>Net worth and category totals on the first of each month</caption>
            <thead>
              <tr>
                <th scope="col">Date</th>
                <th scope="col">Net worth</th>
                <% categories.each_value do |label| %><th scope="col"><%= label %></th><% end %>
                <th scope="col">Credit cards</th>
              </tr>
            </thead>
            <tbody>
              <% points.select { |point| point.date.day == 1 || point == points.last }.each do |point| %>
                <tr>
                  <td><%= point.date.strftime("%b %-d, %Y") %></td>
                  <td><%= number_to_currency(point.net_worth) %></td>
                  <% categories.each_key do |key| %><td><%= number_to_currency(point.categories[key]) %></td><% end %>
                  <td>−<%= number_to_currency(point.debts) %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </section>
<% end %>
