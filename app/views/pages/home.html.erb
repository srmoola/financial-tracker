<% content_for :title, "Overview · Financial Tracker" %>

<% if @sample %>
  <section class="card border border-base-300 bg-pastel" aria-labelledby="link-accounts-heading">
    <div class="card-body gap-4 p-6 sm:p-8">
      <div>
        <h2 id="link-accounts-heading" class="text-xl font-bold tracking-tight">Link your real accounts</h2>
        <p class="mt-1 text-base-content/70">You're looking at sample data. Connect your banks, credit cards and investments to see your own net worth.</p>
      </div>
      <%= render "plaid/connect_buttons", from: "dashboard" %>
    </div>
  </section>
<% end %>

<%# Net worth over time leads once there's a history to chart; until then, the breakdown does. %>
<% has_history = @history.points.size >= 2 %>
<% breakdown = capture do %>
  <%= render "net_worth", breakdown: @breakdown, sample: @sample %>
<% end %>
<% history = capture do %>
  <% if has_history %>
    <%= render "net_worth_history", history: @history, range: @range, view: @view %>
  <% else %>
    <section aria-labelledby="net-worth-history-heading">
      <h2 id="net-worth-history-heading" class="text-lg font-bold tracking-tight">Net worth over time</h2>
      <div class="card mt-3 border border-dashed border-base-300 bg-base-100">
        <div class="card-body items-center p-10 text-center">
          <p class="font-semibold">Your history starts today</p>
          <p class="max-w-md text-sm text-base-content/60">Balances are saved once a day, so this chart fills in as the days go by. Check back tomorrow.</p>
        </div>
      </div>
    </section>
  <% end %>
<% end %>

<div class="<%= class_names("mt-6": @sample) %>">
  <%= has_history ? history : breakdown %>
</div>

<div class="mt-8">
  <%= has_history ? breakdown : history %>
</div>

<div class="mt-6 grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
  <% SampleData::HIGHLIGHTS.each do |highlight| %>
    <% item = nav_item(highlight.section) %>
    <%= link_to public_send(item.path_helper), class: "card group border border-base-300 bg-base-100 transition hover:-translate-y-0.5 hover:shadow-lg hover:shadow-black/5" do %>
      <div class="card-body gap-3 p-6">
        <div class="flex items-center justify-between">
          <div class="grid size-10 place-items-center rounded-xl bg-base-200"><%= nav_icon(item) %></div>
          <svg class="size-5 text-base-content/40 transition group-hover:translate-x-0.5 group-hover:text-base-content" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </div>
        <div>
          <h3 class="font-semibold"><%= item.label %></h3>
          <% if @sample %>
            <p class="mt-2 text-2xl font-bold tracking-tight"><%= highlight.stat %></p>
            <p class="text-sm text-base-content/60"><%= highlight.detail %></p>
          <% elsif highlight.section == :budgets %>
            <% if @budget_statuses.any? %>
              <p class="mt-2 text-2xl font-bold tracking-tight"><%= @budget_statuses.count { |status| status.state == :on_track } %> of <%= @budget_statuses.size %></p>
              <p class="text-sm text-base-content/60">budgets on track</p>
            <% else %>
              <p class="mt-2 text-sm text-base-content/60">Set a limit for a week or a month</p>
            <% end %>
          <% elsif highlight.section == :transactions %>
            <p class="mt-2 text-2xl font-bold tracking-tight"><%= number_to_currency(@spent_this_month) %></p>
            <p class="text-sm text-base-content/60">spent on credit cards this statement period</p>
          <% else %>
            <p class="mt-2 text-sm text-base-content/60">Coming soon</p>
          <% end %>
        </div>
      </div>
    <% end %>
  <% end %>
</div>
