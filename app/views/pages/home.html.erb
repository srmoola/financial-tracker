<% content_for :title, "Overview · Financial Tracker" %>

<div role="alert" class="alert alert-info alert-soft">
  <span>You're looking at sample data. Your real accounts will show up here once you connect them.</span>
</div>

<div class="mt-6">
  <%= render "net_worth", breakdown: NetWorthBreakdown.new(SampleData::ACCOUNTS) %>
</div>

<div class="mt-6 grid gap-4 sm:grid-cols-2 xl:grid-cols-4">
  <% SampleData::HIGHLIGHTS.each do |highlight| %>
    <% item = nav_item(highlight.section) %>
    <%= link_to public_send(item.path_helper), class: "card group border border-base-300 bg-base-100 transition hover:-translate-y-0.5 hover:shadow-lg hover:shadow-black/5" do %>
      <div class="card-body gap-3 p-6">
        <div class="flex items-center justify-between">
          <div class="grid size-10 place-items-center rounded-xl bg-base-200"><%= nav_icon(item) %></div>
          <svg class="size-5 text-base-content/40 transition group-hover:translate-x-0.5 group-hover:text-base-content" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
        </div>
        <div>
          <h3 class="font-semibold"><%= item.label %></h3>
          <p class="mt-2 text-2xl font-bold tracking-tight"><%= highlight.stat %></p>
          <p class="text-sm text-base-content/60"><%= highlight.detail %></p>
        </div>
      </div>
    <% end %>
  <% end %>
</div>
