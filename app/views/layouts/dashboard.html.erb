<% content_for :content do %>
  <div class="drawer lg:drawer-open">
    <input id="sidebar" type="checkbox" class="drawer-toggle">

    <div class="drawer-content flex min-h-screen flex-col bg-base-200">
      <%# Phones and tablets: a full-screen menu instead of the sidebar. %>
      <header class="flex items-center gap-3 border-b border-base-300 bg-base-100 px-4 py-3 lg:hidden" data-controller="dialog" data-action="turbo:before-cache@document->dialog#close">
        <button type="button" class="btn btn-ghost btn-square btn-sm" aria-label="Open menu" aria-haspopup="dialog" data-action="dialog#open">
          <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
            <path d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
        <%= render "shared/logo" %>

        <dialog class="m-0 h-dvh max-h-none w-full max-w-none bg-base-100 p-0 open:flex open:flex-col backdrop:bg-transparent" aria-label="Menu" data-dialog-target="dialog">
          <div class="flex items-center gap-3 px-4 py-3">
            <%= render "shared/logo" %>
            <button type="button" class="btn btn-ghost btn-square btn-sm ml-auto" aria-label="Close menu" data-action="dialog#close" autofocus>
              <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6 6 18"/></svg>
            </button>
          </div>

          <nav class="flex flex-1 items-center justify-center" aria-label="Main">
            <ul class="flex flex-col items-center gap-2">
              <% nav_items.each do |item| %>
                <% path = public_send(item.path_helper) %>
                <li>
                  <%= link_to item.label, path, class: class_names("block rounded-xl px-6 py-2 text-2xl font-semibold tracking-tight transition-colors", current_page?(path) ? "bg-base-200 text-base-content" : "text-base-content/60 hover:text-base-content"),
                        aria: { current: current_page?(path) ? "page" : nil } %>
                </li>
              <% end %>
            </ul>
          </nav>

          <div class="flex items-center gap-3 border-t border-base-300 px-6 py-4">
            <%= link_to settings_path, class: "flex min-w-0 flex-1 items-center gap-3", title: "Settings" do %>
              <%= user_avatar(Current.user) %>
              <div class="min-w-0 flex-1">
                <p class="truncate text-sm font-semibold"><%= Current.user.full_name %></p>
                <p class="truncate text-xs text-base-content/60">Settings</p>
              </div>
            <% end %>
            <%= button_to "Log out", session_path, method: :delete, class: "btn btn-ghost btn-sm" %>
          </div>
        </dialog>
      </header>

      <main class="mx-auto w-full max-w-6xl flex-1 px-4 py-8 sm:px-8 lg:py-12">
        <%= render "shared/flash" %>
        <%= yield %>
      </main>
    </div>

    <div class="drawer-side z-20">

      <aside class="flex min-h-full w-64 flex-col border-r border-base-300 bg-base-100 px-4 py-6">
        <div class="px-2"><%= render "shared/logo" %></div>

        <ul class="menu mt-8 w-full gap-1 p-0">
          <% nav_items.each do |item| %>
            <% path = public_send(item.path_helper) %>
            <li>
              <%= link_to path, class: class_names("rounded-lg font-medium", "bg-base-200 font-semibold": current_page?(path)) do %>
                <%= nav_icon(item) %>
                <%= item.label %>
              <% end %>
            </li>
          <% end %>
        </ul>

        <div class="mt-auto border-t border-base-300 pt-4">
          <%= link_to settings_path, class: class_names("flex items-center gap-3 rounded-lg px-2 py-2 transition-colors hover:bg-base-200", "bg-base-200": current_page?(settings_path)),
                title: "Settings", aria: { current: current_page?(settings_path) ? "page" : nil } do %>
            <%= user_avatar(Current.user) %>
            <div class="min-w-0 flex-1">
              <p class="truncate text-sm font-semibold"><%= Current.user.full_name %></p>
              <p class="truncate text-xs text-base-content/60"><%= Current.user.email_address %></p>
            </div>
            <svg class="size-4 shrink-0 text-base-content/50" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z"/><circle cx="12" cy="12" r="3"/></svg>
          <% end %>
          <%= button_to "Log out", session_path, method: :delete, class: "btn btn-ghost btn-sm btn-block mt-2 justify-start" %>
        </div>
      </aside>
    </div>
  </div>
<% end %>
<%= render template: "layouts/application" %>
