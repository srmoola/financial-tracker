<% content_for :content do %>
  <div class="drawer lg:drawer-open">
    <input id="sidebar" type="checkbox" class="drawer-toggle">

    <div class="drawer-content flex min-h-screen flex-col bg-base-200">
      <header class="flex items-center gap-3 border-b border-base-300 bg-base-100 px-4 py-3 lg:hidden">
        <label for="sidebar" class="btn btn-ghost btn-square btn-sm" aria-label="Open menu">
          <svg class="size-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
            <path d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </label>
        <%= render "shared/logo" %>
      </header>

      <main class="mx-auto w-full max-w-6xl flex-1 px-4 py-8 sm:px-8 lg:py-12">
        <%= render "shared/flash" %>
        <%= yield %>
      </main>
    </div>

    <div class="drawer-side z-20">
      <label for="sidebar" class="drawer-overlay" aria-label="Close menu"></label>

      <aside class="flex min-h-full w-64 flex-col border-r border-base-300 bg-base-100 px-4 py-6">
        <div class="px-2"><%= render "shared/logo" %></div>

        <ul class="menu mt-8 w-full gap-1 p-0">
          <% nav_items.each do |item| %>
            <% path = public_send(item.path_helper) %>
            <li>
              <%= link_to path, class: class_names("rounded-lg font-medium", "bg-base-200 font-semibold": current_page?(path)) do %>
                <%= nav_icon(item) %>
                <%= item.label %>
              <% end %>
            </li>
          <% end %>
        </ul>

        <div class="mt-auto border-t border-base-300 pt-4">
          <div class="flex items-center gap-3 px-2">
            <div class="avatar avatar-placeholder">
              <div class="w-9 rounded-full bg-primary text-primary-content">
                <span class="text-sm font-semibold"><%= Current.user.initials %></span>
              </div>
            </div>
            <div class="min-w-0 flex-1">
              <p class="truncate text-sm font-semibold"><%= Current.user.full_name %></p>
              <p class="truncate text-xs text-base-content/60"><%= Current.user.email_address %></p>
            </div>
          </div>
          <%= button_to "Log out", session_path, method: :delete, class: "btn btn-ghost btn-sm btn-block mt-3 justify-start" %>
        </div>
      </aside>
    </div>
  </div>
<% end %>
<%= render template: "layouts/application" %>
