<% content_for :title, "Accounts · Financial Tracker" %>

<h1 class="text-3xl font-bold tracking-tight">Accounts</h1>

<section class="mt-8" aria-labelledby="connect-heading">
  <h2 id="connect-heading" class="text-lg font-bold tracking-tight">Connect an account</h2>
  <div class="mt-3"><%= render "plaid/connect_buttons", from: "accounts" %></div>
</section>

<section class="mt-10" aria-labelledby="connected-heading">
  <div class="flex flex-wrap items-baseline justify-between gap-2">
    <h2 id="connected-heading" class="text-lg font-bold tracking-tight">Connected</h2>
    <%= link_to "Daily sync history", sync_history_path, class: "text-sm font-medium text-base-content/70 hover:text-base-content hover:underline" %>
  </div>

  <% if @plaid_items.empty? %>
    <div class="card mt-3 border border-dashed border-base-300 bg-base-100">
      <div class="card-body items-center p-10 text-center">
        <p class="font-semibold">No accounts connected yet</p>
        <p class="text-sm text-base-content/60">Connect a bank, credit card or investment account above.</p>
      </div>
    </div>
  <% else %>
    <div class="mt-3 flex flex-col gap-4">
      <% @plaid_items.each do |plaid_item| %>
        <% institution = plaid_item.institution_name.presence || "Connected institution" %>
        <% accounts = sorted_accounts(plaid_item.accounts) %>
        <div class="card border border-base-300 bg-base-100" data-controller="dialog">
          <div class="flex items-center gap-4 px-5 py-4 sm:px-6">
            <div class="grid size-11 shrink-0 place-items-center rounded-xl bg-primary text-sm font-bold text-primary-content" aria-hidden="true">
              <%= institution_initials(institution) %>
            </div>
            <div class="min-w-0 flex-1">
              <h3 class="text-lg leading-tight font-bold tracking-tight break-words"><%= institution %></h3>
              <p class="text-xs text-base-content/60">
                <%= pluralize(accounts.size, "account") %>
                <% if plaid_item.last_synced_at %>· updated <%= time_ago_in_words(plaid_item.last_synced_at) %> ago<% end %>
                · <button type="button" class="cursor-pointer font-medium text-base-content/70 hover:text-error hover:underline" data-action="dialog#open">Disconnect</button>
              </p>
            </div>
            <div class="text-right">
              <p class="font-bold tabular-nums"><%= number_to_currency(NetWorthBreakdown.new(accounts).net_worth) %></p>
              <p class="text-xs text-base-content/60">net balance</p>
            </div>
          </div>

          <%# Accounts sit indented under the institution, along a guide line %>
          <ul class="mb-4 ml-[2.625rem] mr-5 border-l-2 border-base-300 sm:ml-[3.125rem] sm:mr-6" aria-label="<%= institution %> accounts">
            <% accounts.each do |account| %>
              <% color = account_group_color(account) %>
              <li class="flex items-center gap-3 rounded-r-lg py-2.5 pl-6 pr-1 text-sm">
                <span class="<%= class_names("size-2.5 shrink-0 rounded-full", "border-2 border-base-content/40": color.nil?) %>"
                      style="<%= "background-color: #{color}" if color %>" aria-hidden="true"></span>
                <div class="min-w-0 flex-1">
                  <p class="flex min-w-0 items-center gap-2">
                    <span class="truncate font-medium"><%= account.name %></span>
                    <% unless account.shown_on_dashboard? %><span class="badge badge-ghost badge-sm shrink-0">Not shown on dashboard</span><% end %>
                  </p>
                  <p class="text-xs text-base-content/60"><%= [ account_subtype_label(account.subtype), ("•••• #{account.mask}" if account.mask.present?) ].compact.join(" · ") %></p>
                </div>
                <p class="flex-none tabular-nums">
                  <%= "−" if account.account_type == "credit" && !account.balance.zero? %><%= number_to_currency(account.balance) %>
                </p>
              </li>
            <% end %>
          </ul>

          <dialog class="modal modal-bottom sm:modal-middle" aria-labelledby="disconnect-heading-<%= plaid_item.id %>" data-dialog-target="dialog">
            <div class="modal-box">
              <h3 id="disconnect-heading-<%= plaid_item.id %>" class="text-lg font-bold tracking-tight">Disconnect <%= institution %>?</h3>
              <p class="mt-3 text-base-content/80">
                This removes <%= pluralize(accounts.size, "account") %> from Financial Tracker, along with
                <% transaction_count = Transaction.where(account: accounts).count %>
                <%= transaction_count.positive? ? "#{pluralize(transaction_count, "transaction")}, " : "" %>your notes and category changes, and their balance history. Plaid will stop accessing <%= institution %>.
              </p>
              <p class="mt-3 text-sm text-base-content/60">To bring it back, connect it again from this page. Plaid counts that as a new connection.</p>
              <div class="modal-action">
                <button type="button" class="btn" data-action="dialog#close">Cancel</button>
                <%= button_to "Disconnect", plaid_item_path(plaid_item), method: :delete, class: "btn btn-error" %>
              </div>
            </div>
            <form method="dialog" class="modal-backdrop"><button aria-label="Close">close</button></form>
          </dialog>
        </div>
      <% end %>
    </div>
  <% end %>
</section>

<section class="mt-10" aria-labelledby="emails-heading">
  <h2 id="emails-heading" class="text-lg font-bold tracking-tight">Emails</h2>
  <div class="card mt-3 border border-base-300 bg-base-100">
    <div class="flex flex-wrap items-center justify-between gap-4 p-5 sm:px-6">
      <div class="min-w-0">
        <p class="font-semibold">Weekly summary <span class="badge badge-soft badge-sm ml-1 <%= Current.user.weekly_digest? ? "badge-success" : "badge-ghost" %>"><%= Current.user.weekly_digest? ? "On" : "Off" %></span></p>
        <p class="text-sm text-base-content/60">Every Monday: new spending, budgets, net worth, and anything that failed to sync.</p>
      </div>
      <%= button_to Current.user.weekly_digest? ? "Turn off" : "Turn on", weekly_email_path, method: :patch,
            params: { enabled: Current.user.weekly_digest? ? "0" : "1" }, class: "btn btn-sm" %>
    </div>
  </div>
</section>
