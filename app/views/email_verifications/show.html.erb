<% content_for :title, "Confirm your email · Financial Tracker" %>

<h1 class="text-3xl font-bold tracking-tight">Check your email</h1>
<p class="mt-2 text-base-content/70">
  We sent a 6-digit code to <span class="font-semibold text-base-content"><%= Current.user.email_address %></span>.
  Enter it to confirm your email address.
</p>

<%= form_with url: email_verification_path, class: "mt-8 space-y-5" do |form| %>
  <div>
    <%= form.label :code, "Code", class: "mb-1.5 block text-sm font-medium" %>
    <%= form.text_field :code, required: true, autofocus: true, autocomplete: "one-time-code", inputmode: "numeric", pattern: "\\s*\\d{3}\\s*-?\\s*\\d{3}\\s*",
          maxlength: 9, placeholder: "123456", title: "The 6-digit code from the email", class: "input input-lg w-full text-center font-mono text-2xl tracking-[0.4em]" %>
  </div>

  <%= form.submit "Confirm email", class: "btn btn-primary btn-lg btn-block" %>
<% end %>

<%# divs, not paragraphs: a <form> inside a <p> closes the paragraph. %>
<div class="mt-8 space-y-2 text-center text-sm text-base-content/70">
  <div>
    Didn't get it, or it expired?
    <%= button_to "Send a new code", resend_email_verification_path, class: "inline cursor-pointer font-semibold text-base-content hover:underline", form_class: "inline" %>
  </div>
  <div>
    Wrong email?
    <%= button_to "Log out", session_path, method: :delete, class: "inline cursor-pointer font-semibold text-base-content hover:underline", form_class: "inline" %>
    and sign up again.
  </div>
</div>
