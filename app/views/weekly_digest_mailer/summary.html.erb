<% digest = @digest %>
<% section = "margin: 28px 0 8px; font-size: 13px; font-weight: 600; letter-spacing: 0.04em; text-transform: uppercase; color: #666;" %>
<% muted = "color: #666;" %>
<div style="max-width: 560px; margin: 0 auto; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; font-size: 15px; line-height: 1.5; color: #111;">
  <p>Hi <%= @user.first_name %>, here's your week <span style="<%= muted %>">(<%= digest.starts_on.strftime("%b %-d") %> – <%= digest.ends_on.strftime("%b %-d") %>)</span>.</p>

  <p style="<%= section %>">New spending</p>
  <% if digest.purchase_count.zero? %>
    <p>No new purchases came in.</p>
  <% else %>
    <p style="margin: 0;"><span style="font-size: 28px; font-weight: 700;"><%= number_to_currency(digest.spent) %></span> <span style="<%= muted %>">across <%= pluralize(digest.purchase_count, "purchase") %>, <%= weekly_change(digest.spent, digest.spent_the_week_before) %></span></p>
    <p style="margin: 8px 0 0; <%= muted %>"><%= digest.top_categories.map { |category| "#{category.label} #{number_to_currency(category.total)}" }.join(" · ") %></p>
    <table style="width: 100%; margin-top: 12px; border-collapse: collapse;">
      <% digest.biggest_purchases.each do |purchase| %>
        <tr>
          <td style="padding: 6px 0; border-top: 1px solid #eee;"><%= purchase.display_name %> <span style="<%= muted %> font-size: 13px;"><%= purchase.date.strftime("%b %-d") %></span></td>
          <td style="padding: 6px 0; border-top: 1px solid #eee; text-align: right; font-weight: 600;"><%= number_to_currency(purchase.amount) %></td>
        </tr>
      <% end %>
    </table>
  <% end %>

  <% if (subscriptions = digest.new_subscriptions).any? %>
    <p style="<%= section %>">New subscriptions</p>
    <% subscriptions.each do |subscription| %>
      <p style="margin: 0 0 4px;"><%= subscription.merchant %> <span style="<%= muted %>"><%= number_to_currency(subscription.amount) %> <%= subscription.label.downcase %><%= " · possible" if subscription.status == :possible %></span></p>
    <% end %>
    <p style="margin: 4px 0 0;"><%= link_to "See your subscriptions", subscriptions_url %></p>
  <% end %>

  <% if (budgets = digest.budgets).any? %>
    <p style="<%= section %>">Budgets this month</p>
    <table style="width: 100%; border-collapse: collapse;">
      <% budgets.each do |budget, status| %>
        <% state = budget_state(status) %>
        <tr>
          <td style="padding: 6px 0; border-top: 1px solid #eee;"><%= budget.name %><br><span style="<%= muted %> font-size: 13px;"><%= number_to_currency(status.spent) %> of <%= number_to_currency(status.limit) %></span></td>
          <td style="padding: 6px 0; border-top: 1px solid #eee; text-align: right; font-weight: 600; color: <%= { on_track: "#15803d", over_pace: "#b45309", over: "#dc2626" }.fetch(status.state) %>;"><%= state[:label] %></td>
        </tr>
      <% end %>
    </table>
  <% end %>

  <% if (change, net_worth = digest.net_worth_change) %>
    <p style="<%= section %>">Net worth</p>
    <p style="margin: 0;"><strong><%= number_to_currency(net_worth) %></strong>, <%= change.negative? ? "down" : "up" %> <%= number_to_currency(change.abs) %> this week.</p>
  <% end %>

  <% if (failures = digest.sync_failures).any? %>
    <p style="<%= section %>">Needs attention</p>
    <% failures.each do |plaid_item, error| %>
      <p style="margin: 0 0 4px;"><%= plaid_item.institution_name.presence || "A connection" %> didn't sync <span style="<%= muted %> font-size: 13px;">(<%= error %>)</span></p>
    <% end %>
    <p style="margin: 4px 0 0;"><%= link_to "See your accounts", accounts_url %></p>
  <% end %>

  <p style="margin-top: 32px;"><%= link_to "Open Financial Tracker", root_url, style: "display: inline-block; padding: 10px 18px; border-radius: 999px; background: #111; color: #fff; text-decoration: none; font-weight: 600;" %></p>
  <p style="margin-top: 24px; font-size: 13px; <%= muted %>">You get this every Monday. <%= link_to "Turn off weekly emails", @unsubscribe_url, style: "color: #666;" %></p>
</div>
